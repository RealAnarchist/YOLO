import cv2
from pathlib import Path

images = Path("dataset/images")
labels = Path("dataset/labels")

for img_path in images.iterdir():
    img = cv2.imread(str(img_path))
    h, w = img.shape[:2]
    label_path = labels / (img_path.stem + ".txt")

    if not label_path.exists():
        print("No label file for", img_path.name)
        continue

    for line in label_path.read_text().splitlines():
        cls, xc, yc, bw, bh = map(float, line.split())
        x1 = int((xc - bw / 2) * w)
        y1 = int((yc - bh / 2) * h)
        x2 = int((xc + bw / 2) * w)
        y2 = int((yc + bh / 2) * h)
        cv2.rectangle(img, (x1, y1), (x2, y2), (0, 255, 0), 5)

    small = cv2.resize(img, (int(w * 800 / h), 800))
    cv2.imshow("Label check", small)
    if cv2.waitKey(0) == ord("q"):
        break

cv2.destroyAllWindows()